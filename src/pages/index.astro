---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import Logo from '../components/Logo.astro';
import {
  AUDIT_DATE,
  byTheNumbers,
  demo,
  demoUrl,
  docsUrl,
  features,
  inEveryPackage,
  integrations,
  officialUrl,
  packages,
  pricingFacts,
  shortDescription,
  stack,
  workflow,
} from '../content/site';
import { faq } from '../content/faq';
import { alternatives } from '../content/alternatives';
import { faqPage, softwareApplication } from '../lib/schema';
import { iconSvg, type IconName } from '../lib/icons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;


/* Only the broadly-asked questions here; /faq/ carries all of them. */
const homeFaq = faq.filter((f) =>
  [
    'What does self-hosted mean in practice?',
    'How much does ClientOS cost?',
    'What do I need to run it?',
    'Is it really white-label?',
    'Do I get the source code? Is ClientOS open source?',
    'Can I try it before buying?',
  ].includes(f.q),
);

const featureHref = (slug: string) => `${base}/features/${slug}/`;
const screen = (name: string) => `${base}/screens/${name}.webp`;

/**
 * The product tour. Every screenshot is a frame from the official ClientOS
 * tutorial recordings, cropped to the browser window; every sentence restates
 * a point already in src/content/site.ts.
 */
const tour = [
  {
    id: 'orders',
    label: 'Orders',
    title: 'Every order shows whose move it is',
    body: 'Statuses move with briefs, hand-overs and approvals. Paid orders still waiting on a brief sit at the top, ready to chase in one action.',
    feature: 'orders-and-delivery',
  },
  {
    id: 'order-detail',
    label: 'Order page',
    title: 'The brief, the files and the clock in one place',
    body: 'An order carries the brief, the conversation, the invoice and the margin — and shows time with you, time with the client, and whether it was on time.',
    feature: 'orders-and-delivery',
  },
  {
    id: 'storefront',
    label: 'Store and checkout',
    title: 'A sales page for every service, on your domain',
    body: 'Packages, add-ons and five pricing models. The order exists only once the payment provider confirms it.',
    feature: 'service-store-and-checkout',
  },
  {
    id: 'client-portal',
    label: 'Client portal',
    title: 'What your clients see, under your name',
    body: 'Their orders, what is waiting on them and what is outstanding — in your colours, with your words. Clients never see ClientOS.',
    feature: 'white-label-client-portal',
  },
  {
    id: 'messages',
    label: 'Messages',
    title: 'Conversations next to the work',
    body: 'One thread per client and per order, plus your team’s own channels. Send a priced offer and the client accepts and pays it in one click.',
    feature: 'messages-and-support',
  },
  {
    id: 'tickets',
    label: 'Help desk',
    title: 'A help desk in the same portal',
    body: 'A ticket queue with priority, assignee and first-response targets counted in your business hours only.',
    feature: 'messages-and-support',
  },
  {
    id: 'invoices',
    label: 'Invoices',
    title: 'Invoices that settle themselves',
    body: 'Gapless numbering, pay links anyone can use, partial payments, credit notes and subscriptions that bill themselves.',
    feature: 'invoicing-and-payments',
  },
  {
    id: 'reports',
    label: 'Reports',
    title: 'A profit and loss that adds itself up',
    body: 'Revenue, item costs, delivery expenses, gross and net profit, month by month. Every figure per currency, never silently converted.',
    feature: 'invoicing-and-payments',
  },
];

const pillars: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'server',
    title: 'Your server, your database',
    body: 'Every client, order, message, invoice and file lives in a PostgreSQL database on a Linux VPS you rent and control.',
  },
  {
    icon: 'tag',
    title: 'One licence, not a subscription',
    body: `${pricingFacts.licenceScope} ${pricingFacts.noFees}`,
  },
  {
    icon: 'palette',
    title: 'Your brand, nowhere near ours',
    body: 'Your domain, five logo slots and two brand colours that repaint the portal, admin, emails and invoices. Clients never see the name ClientOS.',
  },
  {
    icon: 'wallet',
    title: 'Payments straight to you',
    body: 'Stripe, PayPal, NOWPayments, CoinGate, your own BTCPay Server and manual crypto. Money goes to your accounts; ClientOS takes no cut.',
  },
];

const icon = (name: IconName) => iconSvg(name);

/* The install mock-up, one entry per line so each can animate in on its own. */
const terminal: { text: string; kind?: 'dim' | 'cmd' | 'ok' | 'done' }[] = [
  { text: '# one A record:  clients.youragency.com  →  your server’s IP', kind: 'dim' },
  { text: '$ sudo ./install.sh', kind: 'cmd' },
  { text: '==> Checking the server      2 CPU, 3911 MB memory, 74 GB free disk' },
  { text: '==> Checking your license    available to this key' },
  { text: '==> Checking DNS             clients.youragency.com → 203.0.113.24' },
  { text: '==> Writing deploy/.env      secrets generated' },
  { text: '==> Downloading ClientOS     every file checked by SHA-256', kind: 'ok' },
  { text: '==> Starting                 the API is up' },
  { text: '✓ ClientOS is running.       https://clients.youragency.com/admin/setup', kind: 'done' },
];

const dotMirror = {
  quote:
    'We sell white-label. Our partners trust us with their clients’ names, and for years that list sat on someone else’s servers, on a bill that went up every time we hired. ClientOS put the whole operation on our own server, under our own name, and the monthly bill simply went away.',
  name: 'Shimanto Neer',
  role: 'Founder, Dot Mirror',
  stats: [
    { value: '$0', label: 'monthly portal bill' },
    { value: '100%', label: 'of client history moved' },
    { value: '1 day', label: 'from install to live' },
  ],
};
---

<Base
  title="Self-Hosted Client Portal for Agencies — ClientOS"
  description="ClientOS is a self-hosted, white-label client portal for service agencies: sell, get paid, deliver and invoice on your own server. One-time license from $490, no monthly fee."
  og="og/default.png"
  crumbs={[{ label: 'Home' }]}
  schema={[softwareApplication(canonical), faqPage(homeFaq)]}
>
  <!-- ============================================================ hero -->
  <section class="h-hero">
    <div class="h-hero-glow" aria-hidden="true"></div>
    <div class="h-hero-grid" aria-hidden="true"></div>
    <div class="wrap h-hero-inner">
      <p class="h-pill" data-reveal>
        <span class="h-pill-dot"></span>
        Self-hosted · One-time license from $490
      </p>
      <h1 data-reveal>
        Your client portal.<br />
        Your server. <span class="h-grad">Your data.</span>
      </h1>
      <p class="h-lede" data-reveal>
        Sell services, take payment, deliver work, invoice and support clients from one portal
        under your brand — installed on a server you control with one command.
      </p>
      <div class="h-cta" data-reveal>
        <a class="btn btn-primary h-btn-glow" href={demoUrl('home_hero')} rel="noopener">
          Try the instant demo <Fragment set:html={icon('arrow')} />
        </a>
        <a class="btn h-btn-glass" href="#tour">Take the tour</a>
      </div>
      <ul class="h-points" data-reveal>
        <li><Fragment set:html={icon('check')} />Runs on your own server</li>
        <li><Fragment set:html={icon('check')} />Client data never leaves it</li>
        <li><Fragment set:html={icon('check')} />Unlimited clients and staff</li>
        <li><Fragment set:html={icon('check')} />No per-seat fees</li>
      </ul>

      <div class="h-stage" data-reveal>
        <img
          class="h-shot"
          src={screen('orders')}
          width="1600"
          height="764"
          alt="The ClientOS orders list on clients.youragency.com, with paid orders still waiting on a brief listed at the top"
          fetchpriority="high"
        />
        <div class="h-chip h-chip-a">
          <span class="h-chip-ico h-ico-green"><Fragment set:html={icon('card')} /></span>
          <span><b>Payment confirmed</b><small>the order is created only now</small></span>
        </div>
        <div class="h-chip h-chip-b">
          <span class="h-chip-ico h-ico-orange"><Fragment set:html={icon('check')} /></span>
          <span><b>Delivery approved</b><small>or it approves itself if they go quiet</small></span>
        </div>
        <div class="h-chip h-chip-c">
          <span class="h-chip-ico h-ico-violet"><Fragment set:html={icon('lock')} /></span>
          <span><b>clients.youragency.com</b><small>your domain, your server</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ marquee -->
  <section class="h-marquee" aria-label="Connects to">
    <p class="h-marquee-label">Money and mail go straight to your own accounts</p>
    <div class="h-marquee-track">
      {
        [0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            {integrations.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <!-- ============================================================ pillars -->
  <section class="h-section">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <p class="eyebrow">Why self-host</p>
        <h2>Own your client portal, instead of renting it</h2>
        <p class="lede">{shortDescription}</p>
      </div>
      <div class="h-pillars">
        {
          pillars.map((p, i) => (
            <div class="h-pillar" data-reveal style={`--d:${i * 80}ms`}>
              <span class="h-pillar-ico" set:html={icon(p.icon)} />
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ tour -->
  <section class="h-section h-tour-section" id="tour">
    <div class="wrap">
      <div class="h-head h-head-center" data-reveal>
        <p class="eyebrow">Product tour</p>
        <h2>One portal for the whole job</h2>
        <p class="lede">
          Real screens from ClientOS, taken from the official tutorial recordings. Pick an area.
        </p>
      </div>

      <div class="h-tour" data-tour data-reveal>
        <div class="h-tabs" role="tablist" aria-label="ClientOS screens">
          {
            tour.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        <div class="h-panels">
          {
            tour.map((t, i) => (
              <div
                class="h-panel"
                role="tabpanel"
                id={`panel-${t.id}`}
                aria-labelledby={`tab-${t.id}`}
                hidden={i !== 0}
              >
                <div class="h-panel-copy">
                  <h3>{t.title}</h3>
                  <p>{t.body}</p>
                  <a href={featureHref(t.feature)}>
                    More on this <Fragment set:html={icon('arrow')} />
                  </a>
                </div>
                <img
                  src={screen(t.id)}
                  width="1600"
                  height="764"
                  alt={`ClientOS — ${t.label.toLowerCase()} screen`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ workflow -->
  <section class="h-section">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2>From first click to final invoice</h2>
        <p class="lede">
          ClientOS follows an order the whole way, so nothing falls between tools — and there is
          no sales call in the middle.
        </p>
      </div>
      <ol class="h-flow">
        {
          workflow.map((step, i) => (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <span class="h-flow-n">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================ numbers -->
  <section class="h-dark">
    <div class="h-dark-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="h-head h-head-center" data-reveal>
        <p class="eyebrow h-eyebrow-light">By the numbers</p>
        <h2>Deep where agencies need depth</h2>
      </div>
      <ul class="h-stats">
        {
          byTheNumbers.map((n, i) => (
            <li data-reveal style={`--d:${i * 70}ms`}>
              <span class="h-stat-n">{n.value}</span>
              <span class="h-stat-l">{n.label}</span>
              <span class="h-stat-s">{n.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="h-dark-meta">
        Counts as published on
        <a href={officialUrl('home_numbers')} rel="noopener">getclientos.com</a>, checked {AUDIT_DATE}.
      </p>

      <figure class="h-reel" data-reveal>
        <video
          src={`${base}/video/showreel.mp4`}
          poster={`${base}/video/showreel-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          data-autoplay
          aria-label="The ClientOS showreel: the store, orders, invoices and installing on your own server"
        ></video>
        <figcaption>The 40-second ClientOS showreel.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============================================================ features -->
  <section class="h-section">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <p class="eyebrow">Features</p>
        <h2>Everything an agency runs on</h2>
        <p class="lede">
          getclientos.com documents 12 areas and 78 features. Here they are in the eight groups
          that matter when you are choosing a portal.
        </p>
      </div>
      <div class="h-features">
        {
          features.map((f, i) => (
            <a class="h-feature" href={featureHref(f.slug)} data-reveal style={`--d:${(i % 4) * 60}ms`}>
              <span class="h-feature-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.nav}</h3>
              <p>{f.points[0].title}. {f.points[1].title}. {f.points[2].title}.</p>
              <span class="h-feature-more">
                Read more <Fragment set:html={icon('arrow')} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ data boundary -->
  <section class="h-section h-tint">
    <div class="wrap h-split">
      <div data-reveal>
        <p class="eyebrow">Data ownership</p>
        <h2>Three things leave your server. That is all.</h2>
        <p class="lede">
          Hosted portals keep your clients, contracts and invoices on someone else’s computer.
          ClientOS runs entirely on a server you rent and control.
        </p>
        <p>
          The license check-in carries no client, order or invoice data. If it cannot get through,
          ClientOS keeps working for a seven-day grace period; after that only the admin turns
          read-only — the client portal, checkout and webhooks keep running, and nothing is deleted.
        </p>
        <a class="h-link" href={featureHref('security-and-data-ownership')}>
          Security and data ownership <Fragment set:html={icon('arrow')} />
        </a>
      </div>

      <div class="h-boundary" data-reveal>
        <div class="h-server">
          <p class="h-server-title"><Fragment set:html={icon('server')} /> Your server</p>
          <ul>
            <li><code>/</code> Client portal</li>
            <li><code>/admin</code> Agency admin</li>
            <li><code>/v1</code> API</li>
            <li>PostgreSQL · clients, orders, invoices</li>
            <li>File storage · signed links that expire</li>
          </ul>
        </div>
        <ul class="h-exits">
          <li>
            <span class="h-exit-ico" set:html={icon('mail')} />
            <span><b>Emails you send</b><small>through your Resend account or SMTP server</small></span>
          </li>
          <li>
            <span class="h-exit-ico" set:html={icon('card')} />
            <span><b>Payments</b><small>straight to your own gateway accounts</small></span>
          </li>
          <li class="h-exit-dashed">
            <span class="h-exit-ico" set:html={icon('key')} />
            <span><b>License check-in, twice a day</b><small>the signed license and the version you run — nothing else</small></span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================ install -->
  <section class="h-section">
    <div class="wrap h-split h-split-rev">
      <div class="h-term" data-reveal data-term>
        <div class="h-term-bar">
          <span></span><span></span><span></span>
          <p>root@clientos-prod: ~</p>
        </div>
        <pre><code>{
          terminal.map((line, i) => (
            <span class={`h-line ${line.kind ?? ''}`} style={`--i:${i}`}>{line.text}</span>
          ))
        }</code></pre>
      </div>
      <div data-reveal>
        <p class="eyebrow">Installation</p>
        <h2>Self-hosting without the server headache</h2>
        <p class="lede">
          No Docker files to write, no environment variables, no proxy to configure. One A record,
          one command, and you finish in the browser.
        </p>
        <ul class="h-specs">
          <li><b>~10 min</b><small>install, per the docs</small></li>
          <li><b>2–4 GB</b><small>memory</small></li>
          <li><b>Ubuntu</b><small>22.04 / 24.04 or Debian 12</small></li>
          <li><b>~$10/mo</b><small>server cost</small></li>
        </ul>
        <p class="meta">
          Then one command each: <code>clientos update</code>, <code>clientos rollback</code>,
          <code>clientos backup</code>. Backups do not run until you schedule them.
        </p>
        <div class="btn-row">
          <a class="btn btn-secondary" href={`${base}/install/`}>Install guide</a>
          <a class="btn btn-secondary" href={docsUrl('home_install', '/installation')} rel="noopener">
            Official docs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ pricing -->
  <section class="h-section h-pricing">
    <div class="wrap">
      <div class="h-head h-head-center" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2>Pay once. Own it.</h2>
        <p class="lede">
          {pricingFacts.licenceScope} {pricingFacts.noFees}
        </p>
      </div>
      <div class="h-plans">
        {
          packages.map((p, i) => (
            <div class={p.highlight ? 'h-plan h-plan-hot' : 'h-plan'} data-reveal style={`--d:${i * 80}ms`}>
              {p.note && <span class="h-plan-badge">{p.note}</span>}
              <h3>{p.name}</h3>
              <p class="h-price">{p.price}</p>
              <p class="h-per">{p.period === 'contact' ? 'contact for a quote' : 'one-time'}</p>
              <ul>
                <li><Fragment set:html={icon('check')} />{p.updates}</li>
                <li><Fragment set:html={icon('check')} />{p.support}</li>
                <li><Fragment set:html={icon('check')} />{p.domains}</li>
                <li><Fragment set:html={icon('check')} />{p.install}</li>
              </ul>
              <a
                class={p.highlight ? 'btn btn-primary' : 'btn btn-secondary'}
                href={p.buyUrl ?? officialUrl('home_pricing_custom', '/contact')}
                rel="noopener"
              >
                {p.buyUrl ? `Buy ${p.name}` : 'Ask for a quote'}
              </a>
            </div>
          ))
        }
      </div>
      <div class="h-every" data-reveal>
        <h3>In every package</h3>
        <ul>
          {inEveryPackage.map((item) => <li><Fragment set:html={icon('check')} />{item}</li>)}
        </ul>
      </div>
      <p class="center meta">
        <a href={`${base}/pricing/`}>Full pricing summary</a> · Prices in US dollars, checked {AUDIT_DATE}.
      </p>
    </div>
  </section>

  <!-- ============================================================ case study -->
  <section class="h-section">
    <div class="wrap">
      <figure class="h-story" data-reveal>
        <div class="h-story-glow" aria-hidden="true"></div>
        <p class="eyebrow h-eyebrow-light">Case study · Dot Mirror</p>
        <blockquote>“{dotMirror.quote}”</blockquote>
        <figcaption>
          <img src={`${base}/img/shimanto-neer.png`} width="56" height="56" alt="" loading="lazy" />
          <span><b>{dotMirror.name}</b><small>{dotMirror.role}</small></span>
        </figcaption>
        <ul class="h-story-stats">
          {
            dotMirror.stats.map((s) => (
              <li>
                <b>{s.value}</b>
                <small>{s.label}</small>
              </li>
            ))
          }
        </ul>
        <p class="h-story-src">
          ClientOS’s own published figures, from the
          <a href={officialUrl('home_casestudy', '/case-studies/dotmirror')} rel="noopener">
            Dot Mirror case study
          </a>.
        </p>
      </figure>
    </div>
  </section>

  <!-- ============================================================ compare -->
  <section class="h-section h-tint">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <p class="eyebrow">Compared with hosted portals</p>
        <h2>Switching from a subscription portal</h2>
        <p class="lede">
          Built from each vendor’s own published pricing, with the date it was checked — and each
          comparison says plainly who should stay where they are.
        </p>
      </div>
      <div class="h-features">
        {
          alternatives.map((a, i) => (
            <a class="h-feature" href={`${base}/${a.slug}/`} data-reveal style={`--d:${i * 60}ms`}>
              <span class="h-feature-n">vs</span>
              <h3>{a.product}</h3>
              <p>{a.description}</p>
              <span class="h-feature-more">
                Compare <Fragment set:html={icon('arrow')} />
              </span>
            </a>
          ))
        }
        <a class="h-feature" href={`${base}/client-portal-software/`} data-reveal style="--d:180ms">
          <span class="h-feature-n">∑</span>
          <h3>The whole landscape</h3>
          <p>
            A curated, neutral list of self-hosted and hosted client portals, plus the onboarding,
            proposal, invoicing and reporting tools around them.
          </p>
          <span class="h-feature-more">
            Browse the list <Fragment set:html={icon('arrow')} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ stack -->
  <section class="h-section">
    <div class="wrap">
      <div class="h-head h-head-center" data-reveal>
        <p class="eyebrow">Technology</p>
        <h2>Production-grade, packaged for one server</h2>
        <p class="lede">
          The stack modern SaaS runs on, assembled so it installs on a single VPS and updates with
          one command.
        </p>
      </div>
      <ul class="h-stack" data-reveal>
        {
          stack.map((s) => (
            <li>
              <b>{s.name}</b>
              <small>{s.role}</small>
            </li>
          ))
        }
      </ul>
      <p class="center meta">
        Releases are verified by SHA-256 before they install. ClientOS is self-hosted but
        <strong>not open source</strong> — it ships as ready-built Docker images.
      </p>
    </div>
  </section>

  <!-- ============================================================ faq -->
  <section class="h-section h-tint">
    <div class="wrap h-faq">
      <div data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2>The questions agencies ask first</h2>
        <p>
