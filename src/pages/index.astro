<script>
  /* Scroll reveal. The hidden starting state is gated on `.js`, so the page
     reads complete with JavaScript off. */
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  /* The showreel plays only while it is on screen. */
  const reel = document.querySelector<HTMLVideoElement>('video[data-autoplay]');
  if (reel && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) reel.play().catch(() => {});
      else reel.pause();
    }).observe(reel);
  } else if (reel) {
    reel.controls = true;
  }

  /* Product tour tabs, with arrow-key movement per the WAI-ARIA tabs pattern. */
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((tour) => {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

