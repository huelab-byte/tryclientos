---
/**
 * Fades `[data-reveal]` blocks in as they scroll into view. The hidden starting
 * state is gated on `html.js`, so with JavaScript off the page reads complete.
 * `--d` on an element delays it, for staggering a row of cards.
 */
---

<script>
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style is:global>
  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
  }
  html.js [data-reveal].in {
    opacity: 1;
    transform: none;
  }
</style>
