---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';

export interface Crumb {
  label: string;
  /** Omit on the last crumb — the current page is not a link. */
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Overrides the default social card. Path relative to base, e.g. 'og/pricing.png'. */
  og?: string;
  /** Rendered as a visible breadcrumb trail and as BreadcrumbList JSON-LD. */
  crumbs?: Crumb[];
  /** Extra JSON-LD objects; @context is added here so callers never repeat it. */
  schema?: Record<string, unknown>[];
  /** Set on pages that should not be indexed. Nothing uses it yet. */
  noindex?: boolean;
}

const { title, description, og = 'og/default.png', crumbs = [], schema = [], noindex } =
  Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * Astro.url.pathname already carries `base`, so one `new URL` against
 * `Astro.site` gives the canonical, the OG url and the sitemap the same string.
 */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/${og}`, Astro.site).href;

/* No site-name suffix: every `title` passed in is already written to stand
   alone under 60 characters, and appending one only pushed them past the
   length a search result shows. scripts/check-links.mjs enforces the limit. */

const breadcrumbSchema =
  crumbs.length > 1
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          ...(c.href ? { item: new URL(c.href, Astro.site).href } : {}),
        })),
      }
    : null;

const graph = [...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/og/apple-touch-icon.png`} />
    <meta name="theme-color" content="#fd4105" />

    <link
      rel="preload"
      href={`${base}/fonts/GeneralSans-Bold.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ClientOS`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    {
      graph.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(
            graph.length === 1
              ? { '@context': 'https://schema.org', ...graph[0] }
              : { '@context': 'https://schema.org', '@graph': graph },
          )}
        />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />

    {
      crumbs.length > 1 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <div class="wrap">
            <ol>
              {crumbs.map((c) => (
                <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
